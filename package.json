{
  "name": "@hyl_aa/napcat",
  "version": "1.2.4",
  "description": "OpenClaw QQ channel plugin via NapCat (OneBot 11)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aliang1337/openclaw-napcat.git"
  },
  "files":[
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "qq",
    "napcat",
    "onebot",
    "chatbot"
  ],
  "scripts": {
    "build":"tsc",
    "watch":"tsc -w",
    "prepack":"npm run build",
    "pack": "npm pack"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "napcat",
      "label": "QQ (NapCat)",
      "selectionLabel": "QQ via NapCat (OneBot 11)",
      "docsPath": "/channels/napcat",
      "docsLabel": "napcat",
      "blurb": "QQ messaging via NapCat OneBot 11 reverse WebSocket.",
      "aliases": [
        "qq",
        "onebot"
      ],
      "order": 90,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@hyl_aa/napcat",
      "localPath": "extensions/napcat",
      "defaultChoice": "npm"
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "openclaw": "^2026.10.9",
    "typescript": "^7.0.2"
  }
}
